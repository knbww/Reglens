# ---------------------------------------------------------------------------
# RegLens AI — environment
#
# Local:  cp .env.example .env.local   then fill in the values below.
# Vercel: add the same keys under Project → Settings → Environment Variables.
#
# Never commit real keys. .env.local is gitignored.
# ---------------------------------------------------------------------------


# === 1. Database — Supabase Postgres =======================================
# Local development (npm run supabase:start prints these):
#   DATABASE_URL / DIRECT_URL both point at 127.0.0.1:54322
#
# Hosted Supabase — Project → Settings → Database → Connection string:
#   DATABASE_URL  = the "Transaction pooler" URI, port 6543, plus ?pgbouncer=true
#   DIRECT_URL    = the "Direct connection" URI, port 5432   (used by migrations)
#
# Example (hosted):
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DATABASE_URL=""
DIRECT_URL=""


# === 2. Auth — Supabase ====================================================
# Hosted Supabase — Project → Settings → API Keys.
#
# Supabase issues two key formats. RegLens accepts either; use whichever your
# project shows, and leave the other pair blank.
#
#   New format (current projects):
#     NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY = sb_publishable_…  (browser-safe)
#     SUPABASE_SECRET_KEY                  = sb_secret_…       (SERVER ONLY)
#
#   Legacy JWT format (older projects):
#     NEXT_PUBLIC_SUPABASE_ANON_KEY = eyJhbGciOi…  (browser-safe)
#     SUPABASE_SERVICE_ROLE_KEY     = eyJhbGciOi…  (SERVER ONLY)
#
# The secret / service_role key is used only by the seed script to create the
# demo account. Never expose it to the browser and never commit it.
NEXT_PUBLIC_SUPABASE_URL=""

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# Legacy alternatives — only if your project still shows anon / service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""


# === 3. AI provider — Groq =================================================
# Get a key at https://console.groq.com/keys
#
# With GROQ_API_KEY set, the AI Policy Analyst calls Groq.
# Without it, RegLens falls back to a deterministic analysis built from the
# business profile and the retrieved policy records, clearly labelled as demo
# output. Nothing in the product breaks either way.
GROQ_API_KEY=""
# Optional. Defaults to llama-3.3-70b-versatile.
GROQ_MODEL=""
# Optional. Timeout in ms for a full analysis, default 35000. Conversational
# replies use a fixed 8s. When exceeded, RegLens falls back to the local analyst.
GROQ_TIMEOUT_MS=""


# === 4. Demo account =======================================================
# Created by `npm run db:seed`. Powers the one-click demo sign-in button.
NEXT_PUBLIC_DEMO_EMAIL="demo@reglens.ai"
DEMO_PASSWORD="reglens-demo-2025"
