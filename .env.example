# ---------------------------------------------------------------------------
# RegLens AI — environment
#
# Local:  cp .env.example .env.local   then fill in the values below.
# Vercel: add the same keys under Project → Settings → Environment Variables.
#
# Never commit real keys. .env.local is gitignored.
# ---------------------------------------------------------------------------


# === 1. Database — Supabase Postgres =======================================
# Local development (npm run supabase:start prints these):
#   DATABASE_URL / DIRECT_URL both point at 127.0.0.1:54322
#
# Hosted Supabase — Project → Settings → Database → Connection string:
#   DATABASE_URL  = the "Transaction pooler" URI, port 6543, plus ?pgbouncer=true
#   DIRECT_URL    = the "Direct connection" URI, port 5432   (used by migrations)
#
# Example (hosted):
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DATABASE_URL=""
DIRECT_URL=""


# === 2. Auth — Supabase ====================================================
# Hosted Supabase — Project → Settings → API.
#   NEXT_PUBLIC_SUPABASE_URL       = Project URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  = anon / publishable key (safe in the browser)
#   SUPABASE_SERVICE_ROLE_KEY      = service_role key — SERVER ONLY, never expose
#                                    (used solely by the seed script to create
#                                     the demo account)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""


# === 3. AI provider — Groq =================================================
# Get a key at https://console.groq.com/keys
#
# With GROQ_API_KEY set, the AI Policy Analyst calls Groq.
# Without it, RegLens falls back to a deterministic analysis built from the
# business profile and the retrieved policy records, clearly labelled as demo
# output. Nothing in the product breaks either way.
GROQ_API_KEY=""
# Optional. Defaults to llama-3.3-70b-versatile.
GROQ_MODEL=""
# Optional. Timeout in ms for a full analysis, default 35000. Conversational
# replies use a fixed 8s. When exceeded, RegLens falls back to the local analyst.
GROQ_TIMEOUT_MS=""


# === 4. Demo account =======================================================
# Created by `npm run db:seed`. Powers the one-click demo sign-in button.
NEXT_PUBLIC_DEMO_EMAIL="demo@reglens.ai"
DEMO_PASSWORD="reglens-demo-2025"
